# Crypto Standard Tier 1 – environment configuration
# Copy this file to .env and adjust values as needed.
# DO NOT commit .env to version control.
# NO private/API keys are required for signal mode (Tier 1 default).

# ── Runtime mode ──────────────────────────────────────────────────────────────
# Run one cycle then exit (default). Set to true for a continuous loop.
CRYPTO_RUN_FOREVER=false

# Seconds to sleep between cycles when CRYPTO_RUN_FOREVER=true
CRYPTO_CYCLE_INTERVAL_SECONDS=60

# ── Candidate / position limits ───────────────────────────────────────────────
CRYPTO_CANDIDATE_COUNT=5
CRYPTO_MAX_OPEN_POSITIONS=5

# ── Position envelope ─────────────────────────────────────────────────────────
# Fixed MEXC position amount: $50 at 20x isolated leverage uses at most $2.50
# initial margin. Quantity is calculated in contracts for each coin.
CRYPTO_POSITION_NOTIONAL_USDT=50.0
CRYPTO_MAX_ISOLATED_MARGIN_PER_POSITION_USDT=2.5
CRYPTO_DAILY_LOSS_LIMIT_USDT=20.0
CRYPTO_DAILY_PROFIT_TARGET_USDT=40.0
# Every qualified plan has $50 position notional, an ATR-based protective stop,
# and an exact gross $3 take-profit target.
CRYPTO_TAKE_PROFIT_USDT=3.0
# Close every remaining open paper position when the basket's marked net
# profit reaches this fixed target.
CRYPTO_BASKET_PROFIT_TARGET_USDT=5.0
CRYPTO_STOP_ATR_PERIOD=14
CRYPTO_STOP_ATR_MULTIPLIER=1.5
# Bounded adaptive stop: 0.2% minimum room, 2.0% maximum room.
CRYPTO_MINIMUM_STOP_PCT=0.002
CRYPTO_MAXIMUM_STOP_PCT=0.02
# Once price reaches 65% of the original target, protect 35% of that target.
CRYPTO_PROFIT_LOCK_ACTIVATION_PCT=65
CRYPTO_PROFIT_LOCK_PROTECTION_PCT=35
CRYPTO_LEVERAGE_MIN=20
CRYPTO_LEVERAGE_MAX=20
# Calibrated quality gate: a plan requires all key confirmations, not just a
# fast move. Scores remain bounded 0–100 and are not outcome predictions.
CRYPTO_MINIMUM_SIGNAL_CONFIDENCE=70
CRYPTO_RELATIVE_VOLUME_MIN=1.1
CRYPTO_MINIMUM_LEVEL_DISTANCE_PCT=0.003
# Multi-touch support/resistance zones use completed 15m + 4h swings. A setup
# must reclaim its zone and stay close enough to it; stale setups never size.
CRYPTO_STRUCTURE_ZONE_WIDTH_PCT=0.004
CRYPTO_STRUCTURE_ZONE_MIN_TOUCHES=2
CRYPTO_ENTRY_ZONE_PROXIMITY_PCT=0.004
CRYPTO_ENTRY_SETUP_EXPIRY_CANDLES=4
CRYPTO_MAX_CORRELATION=0.80
# Five $2.50 isolated-margin positions can be planned at once.
CRYPTO_MAX_TOTAL_ISOLATED_MARGIN_USDT=12.5
# Creates local paper positions only. Never enables live MEXC orders.
CRYPTO_PAPER_TRADING_ENABLED=false
# margin_mode is fixed to "isolated" in Tier 1 and cannot be overridden.

# ── Explicit one-position live canary (disabled by default) ───────────────────
# This is a separately confirmed test path, never part of normal scanning.
# It permits exactly one fully qualified $50 / 20x isolated entry with MEXC
# stop-loss and take-profit included in the same create-order request.
CRYPTO_LIVE_CANARY_ENABLED=false
# Broader, one-position validation path. It retains all exchange protections but
# accepts a directional setup before the standard completed-retest gate. Never
# enable it beside the normal canary or five-position cycle.
CRYPTO_LIVE_TRIAL_CANARY_ENABLED=false
CRYPTO_TRIAL_MINIMUM_SIGNAL_CONFIDENCE=50
# Use a NEW MEXC Futures trading key with Order Placing + View Order Details only,
# withdrawals disabled, and the VPS public IP allowlisted. Never paste key values
# into chat or commit this file:
# MEXC_TRADING_API_KEY=
# MEXC_TRADING_API_SECRET=

# ── Explicit protected live cycle (disabled by default) ───────────────────────
# Never set this to true until the one-position live canary has been confirmed.
# A cycle submits only fully qualified, correlation-clear plans and never more
# than five positions at the fixed $50 / 20x isolated profile.
CRYPTO_LIVE_CYCLE_ENABLED=false
CRYPTO_LIVE_CYCLE_MAX_POSITIONS=5

# ── Filter thresholds ─────────────────────────────────────────────────────────
# Maximum bid/ask spread as a percentage (0.15 = 0.15%)
CRYPTO_MAX_SPREAD_PCT=0.15
# Minimum 24h USDT turnover to include a contract
CRYPTO_MIN_TURNOVER_USDT_24H=5000000

# ── Staleness ─────────────────────────────────────────────────────────────────
# Reject ticker data older than this many seconds
CRYPTO_STALE_DATA_THRESHOLD_SECONDS=300

# ── Scan / probe limits ───────────────────────────────────────────────────────
CRYPTO_SCAN_LIMIT=200
CRYPTO_PROBE_LIMIT=30
# Independent Binance/Bybit confirmation is bounded to the strongest scored
# shortlist so public providers cannot slow every one of the 1,000+ contracts.
CRYPTO_CROSS_MARKET_PROBE_LIMIT=10
CRYPTO_CANDLE_LIMIT=100
# 4-hour candles used for multi-touch support/resistance context
CRYPTO_CONTEXT_CANDLE_LIMIT=40

# ── HTTP transport ────────────────────────────────────────────────────────────
CRYPTO_REQUEST_TIMEOUT_SECONDS=10

# ── Optional notifications (disabled without BOTH values) ──────────────────────
# CRYPTO_TELEGRAM_BOT_TOKEN=
# CRYPTO_TELEGRAM_CHAT_ID=
# CRYPTO_HEARTBEAT_EVERY_CYCLES=30
# Fixed Dubai-time owner reports: daily at 23:59, Sunday at 23:30, and the
# last calendar day of each month at 23:45. Values other than these fail closed.
# CRYPTO_TELEGRAM_DAILY_SUMMARY_TIME=23:59
# CRYPTO_TELEGRAM_WEEKLY_SUMMARY_TIME=23:30
# CRYPTO_TELEGRAM_MONTHLY_SUMMARY_TIME=23:45

# ── OpenAI operator commentary (paper events and owner reports) ────────────────
# When OPENAI_API_KEY is configured, commentary is enabled by default. It receives
# compact recorded evidence only and cannot select trades, alter the $2/$3/$5
# controls, or execute anything. Set false only to disable commentary deliberately.
# CRYPTO_AI_EXPLANATIONS_ENABLED=true
# CRYPTO_AI_REQUEST_TIMEOUT_SECONDS=10
# Covers all possible local lifecycle events in one cycle (five positions).
# CRYPTO_AI_MAX_EVENTS_PER_CYCLE=10
# OPENAI_API_KEY=
# Optional model overrides:
# CRYPTO_OPENAI_MODEL=gpt-5-mini
# CoinMarketCap is optional. Without this key, its provider status is unavailable.
# COINMARKETCAP_API_KEY=

# ── Laptop-only private account checks (read-only, explicit CLI flag) ─────────
# Keep these only on the laptop. Withdrawals must be disabled in MEXC.
# CRYPTO_PRIVATE_READONLY_ENABLED=false
# MEXC_API_KEY=
# MEXC_API_SECRET=

# ── Paths (optional; defaults to ./runtime/ and ./logs/ relative to main.py) ──
# CRYPTO_RUNTIME_DIR=C:\agenticcore\crypto\runtime
# CRYPTO_LOG_DIR=C:\agenticcore\crypto\logs
# First laptop check (no network, messages, AI request, or exchange call):
# python main.py --preflight
