# Premium Tier 1 starts safely in mock + signal-only mode.
PREMIUM_MODE=mock
PREMIUM_SIGNAL_ONLY=true
PREMIUM_RUN_FOREVER=false
PREMIUM_WORKER_NAME=premium-tier1-worker-1

# Windows MT5 terminal selection. The terminal must already be logged in.
# PREMIUM_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# PREMIUM_MT5_LOGIN=
# PREMIUM_MT5_SERVER=JustMarkets-Demo
PREMIUM_MT5_EXPECTED_BROKER=JustMarkets
PREMIUM_MT5_ACCOUNT_TYPE=DEMO
PREMIUM_MT5_SYMBOL_SUFFIX=.m

# Hard safety guards.
PREMIUM_RISK_ENTRY_START=05:00
PREMIUM_RISK_ENTRY_STOP=23:29
PREMIUM_RISK_MAX_POSITIONS=7
PREMIUM_RISK_MAX_PER_PAIR=3
PREMIUM_RISK_MAX_CURRENCY_EXPOSURE=3
PREMIUM_RISK_MAX_CORRELATED_POSITIONS=2
PREMIUM_RISK_DAILY_LOSS_PCT=15
PREMIUM_RISK_DAILY_PROFIT_PCT=20
PREMIUM_RISK_GATE_FOREX_LOW_VOL=true
PREMIUM_RISK_GATE_METALS_LOW_VOL=false